{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beard-gallery",
  "account_id": "2817f1011a1407e7889b6fb3ca98f377",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beard-gallery",
      "database_id": "5a0caa27-6c4e-46ab-87fd-05db9a875823"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "1d93df66b610446a939c975cb654cacf"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOTE_ROOM",
        "class_name": "VoteRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoteRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "beard.jonah.art",
      "custom_domain": true
    }
  ]
}
